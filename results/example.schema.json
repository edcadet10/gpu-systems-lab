{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edcadet10/gpu-systems-lab/raw/main/results/example.schema.json",
  "title": "GPU Systems Lab benchmark report",
  "type": "object",
  "required": ["schema_version", "generated_at", "environment", "protocol", "results"],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "git_commit": { "type": ["string", "null"] },
    "environment": { "type": "object" },
    "protocol": { "type": "object" },
    "results": { "type": "array", "minItems": 1, "items": { "type": "object" } }
  },
  "additionalProperties": true
}
