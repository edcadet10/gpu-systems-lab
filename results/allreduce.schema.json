{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edcadet10/gpu-systems-lab/raw/main/results/allreduce.schema.json",
  "title": "All-reduce benchmark report",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark_type",
    "generated_at",
    "git_commit",
    "environment",
    "protocol",
    "result"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "benchmark_type": { "const": "allreduce" },
    "generated_at": { "type": "string", "format": "date-time" },
    "git_commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "environment": {
      "type": "object",
      "required": [
        "world_size",
        "device_name",
        "compute_capability",
        "pytorch_version",
        "cuda_runtime_version",
        "nccl_version"
      ],
      "properties": {
        "world_size": { "type": "integer", "minimum": 2 },
        "device_name": { "type": "string", "minLength": 1 },
        "compute_capability": {
          "type": "array",
          "prefixItems": [
            { "type": "integer", "minimum": 1 },
            { "type": "integer", "minimum": 0 }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "pytorch_version": { "type": "string", "minLength": 1 },
        "cuda_runtime_version": { "type": ["string", "null"] },
        "nccl_version": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": { "type": "integer", "minimum": 0 }
        }
      },
      "additionalProperties": false
    },
    "protocol": {
      "type": "object",
      "required": ["timer", "warmup_iterations", "measured_iterations", "rank_aggregation"],
      "properties": {
        "timer": { "const": "CUDA events" },
        "warmup_iterations": { "type": "integer", "minimum": 1 },
        "measured_iterations": { "type": "integer", "minimum": 1 },
        "rank_aggregation": {
          "const": "maximum latency for each measured iteration"
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "message_bytes",
        "dtype",
        "correctness_observed",
        "correctness_expected",
        "critical_path_latency_ms"
      ],
      "properties": {
        "message_bytes": { "type": "integer", "minimum": 1 },
        "dtype": { "enum": ["float16", "bfloat16", "float32"] },
        "correctness_observed": { "type": "number" },
        "correctness_expected": { "type": "number" },
        "critical_path_latency_ms": {
          "type": "object",
          "required": ["samples", "median", "observed_minimum", "observed_maximum"],
          "properties": {
            "samples": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "number", "minimum": 0 }
            },
            "median": { "type": "number", "minimum": 0 },
            "observed_minimum": { "type": "number", "minimum": 0 },
            "observed_maximum": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
