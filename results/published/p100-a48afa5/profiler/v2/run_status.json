        "\nimport json\nimport sqlite3\nimport sys\nfrom pathlib import Path\n\ndatabase = Path(sys.argv[1])\nprovider = sys.argv[2]\noutput = Path(sys.argv[3])\nconnection = sqlite3.connect(f'file:{database}?mode=ro', uri=True)\ntry:\n    tables = {\n        row[0]\n        for row in connection.execute(\n            \"select name from sqlite_master where type = 'table'\"\n        )\n    }\n    kernel_tables = sorted(\n        table\n        for table in tables\n        if table in {\n            'CUPTI_ACTIVITY_KIND_KERNEL',\n            'CUPTI_ACTIVITY_KIND_CONCURRENT_KERNEL',\n        }\n    )\n    kernel_rows = {\n        table: connection.execute(f'SELECT count(*) FROM \"{table}\"').fetchone()[0]\n        for table in kernel_tables\n    }\n    nvtx_names = [\n        row[0]\n        for row in connection.execute(\n            \"SELECT text FROM NVTX_EVENTS WHERE text IS NOT NULL ORDER BY start\"\n        )\n    ]\nfinally:\n    connection.close()\nexpected_nvtx = f'residual_rmsnorm:{provider}'\npayload = {\n    'provider': provider,\n    'sqlite_relative_path': f'analysis/{database.name}',\n    'kernel_table_rows': kernel_rows,\n    'kernel_rows': sum(kernel_rows.values()),\n    'nvtx_names': nvtx_names,\n    'expected_nvtx': expected_nvtx,\n}\noutput.write_text(json.dumps(payload, indent=2, sort_keys=True) + '\\n', encoding='utf-8')\nprint(json.dumps(payload, indent=2, sort_keys=True))\nassert payload['kernel_rows'] > 0\nassert expected_nvtx in nvtx_names\n",
