{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edcadet10/gpu-systems-lab/raw/main/src/gpu_systems_lab/schemas/allreduce-v3.schema.json",
  "title": "All-reduce benchmark report v3",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark_type",
    "generated_at",
    "git_commit",
    "git_dirty",
    "environment",
    "protocol",
    "result"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "benchmark_type": { "const": "allreduce" },
    "generated_at": { "type": "string", "format": "date-time" },
    "git_commit": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "git_dirty": { "type": ["boolean", "null"] },
    "environment": {
      "type": "object",
      "required": ["world_size", "ranks"],
      "properties": {
        "world_size": { "type": "integer", "minimum": 2 },
        "ranks": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/rank_environment" }
        }
      },
      "additionalProperties": false
    },
    "protocol": {
      "type": "object",
      "required": [
        "timer",
        "warmup_iterations",
        "measured_iterations",
        "rank_aggregation",
        "correctness_consensus"
      ],
      "properties": {
        "timer": { "const": "CUDA events" },
        "warmup_iterations": { "type": "integer", "minimum": 1 },
        "measured_iterations": { "type": "integer", "minimum": 1 },
        "rank_aggregation": { "const": "maximum latency for each measured iteration" },
        "correctness_consensus": { "const": "all-rank integer minimum" }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "message_bytes",
        "dtype",
        "correctness_observed",
        "correctness_expected",
        "critical_path_latency_ms"
      ],
      "properties": {
        "message_bytes": { "type": "integer", "minimum": 1 },
        "dtype": { "enum": ["float16", "bfloat16", "float32"] },
        "correctness_observed": { "type": "number" },
        "correctness_expected": { "type": "number" },
        "critical_path_latency_ms": {
          "$ref": "#/$defs/latency"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "rank_environment": {
      "type": "object",
      "required": [
        "rank",
        "local_rank",
        "device_index",
        "device_name",
        "compute_capability",
        "total_memory_bytes",
        "python_version",
        "operating_system",
        "kernel_release",
        "machine",
        "pytorch_version",
        "cuda_runtime_version",
        "nccl_version",
        "nvidia_smi_query_status",
        "driver_version",
        "performance_state",
        "sm_clock_mhz",
        "memory_clock_mhz",
        "power_limit_watts"
      ],
      "properties": {
        "rank": { "type": "integer", "minimum": 0 },
        "local_rank": { "type": "integer", "minimum": 0 },
        "device_index": { "type": "integer", "minimum": 0 },
        "device_name": { "type": "string", "minLength": 1 },
        "total_memory_bytes": { "type": "integer", "minimum": 1 },
        "compute_capability": {
          "type": "array",
          "prefixItems": [
            { "type": "integer", "minimum": 1 },
            { "type": "integer", "minimum": 0 }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "python_version": { "type": "string", "minLength": 1 },
        "operating_system": { "type": "string", "minLength": 1 },
        "kernel_release": { "type": "string", "minLength": 1 },
        "machine": { "type": "string", "minLength": 1 },
        "pytorch_version": { "type": "string", "minLength": 1 },
        "cuda_runtime_version": { "type": ["string", "null"] },
        "nccl_version": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": { "type": "integer", "minimum": 0 }
        },
        "nvidia_smi_query_status": { "enum": ["ok", "unavailable", "error"] },
        "driver_version": { "type": ["string", "null"] },
        "performance_state": { "type": ["string", "null"] },
        "sm_clock_mhz": { "type": ["number", "null"], "minimum": 0 },
        "memory_clock_mhz": { "type": ["number", "null"], "minimum": 0 },
        "power_limit_watts": { "type": ["number", "null"], "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "latency": {
      "type": "object",
      "required": ["samples", "median", "observed_minimum", "observed_maximum"],
      "properties": {
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number", "minimum": 0 }
        },
        "median": { "type": "number", "minimum": 0 },
        "observed_minimum": { "type": "number", "minimum": 0 },
        "observed_maximum": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
